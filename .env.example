POSTGRES_USER=tripmate
POSTGRES_PASSWORD=
POSTGRES_DB=tripmate
POSTGRES_SSLMODE=disable
POSTGRES_OPTIMEOUT=15s

APP_POSTGRES_HOST=app-postgres
APP_POSTGRES_PORT=5432
APP_EXTERNAL_POSTGRES_PORT=5432

ROUTE_GENERATOR_POSTGRES_HOST=route-generator-postgres
ROUTE_GENERATOR_POSTGRES_PORT=5432
ROUTE_GENERATOR_EXTERNAL_POSTGRES_PORT=5433

APP_PORT=8080
ROUTE_GENERATOR_PORT=8081

APP_SERVER_ADDR=:8080
ROUTE_GENERATOR_SERVER_ADDR=:8081
ROUTE_GENERATOR_SERVER_TO_CONNECT=route-generator:8081

LOGGER_LEVEL=DEBUG

PASSWORDHASHER_ITERATIONS=3
# Memory is measured in KiB. So 64*1024=65536
PASSWORDHASHER_MEMORY=65536
PASSWORDHASHER_PARALLELISM=2
PASSWORDHASHER_SALT_LENGTH=16
PASSWORDHASHER_KEY_LENGTH=32

MAX_REQUESTS_AMOUNT=30
WINDOW_SIZE=10s

CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
