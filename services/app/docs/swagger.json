                "description": "Gets trips",
                "tags": [
                    "trips"
                ],
                "summary": "Gets Trip",
                "operationId": "get-trips",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "OwnerID ID",
                        "name": "ownerID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved trip",
