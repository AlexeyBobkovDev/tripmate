    "definitions": {
        "core_http_response.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "full error text"
                },
                "message": {
                    "type": "string",
                    "example": "short human-readable message"
                }
            }
        },
        "domain.Interest": {
            "type": "string",
            "enum": [
                "history",
                "nature",
                "food",
                "architecture"
            ],
            "x-enum-varnames": [
                "InterestHistory",
                "InterestNature",
                "InterestFood",
                "InterestArchitecture"
            ]
        },
        "domain.Location": {
            "type": "object",
            "required": [
                "latitude",
                "longitude",
                "name"
            ],
            "properties": {
                "latitude": {
                    "type": "number",
                    "example": 55.7539
                },
                "longitude": {
                    "type": "number",
                    "example": 37.6208
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Red Square"
                }
            }
        },
        "domain.Money": {
            "type": "object",
            "required": [
                "amount_minor_units",
                "currency"
            ],
            "properties": {
                "amount_minor_units": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1500000
                },
                "currency": {
                    "type": "string",
                    "example": "RUB"
                }
            }
        },
        "trips_transport_http.CreateTripRequest": {
            "type": "object",
            "required": [
                "budget",
                "end_date",
                "interests",
                "name",
                "planning_area",
                "start_date",
                "start_location",
                "time_zone"
            ],
            "properties": {
                "budget": {
                    "$ref": "#/definitions/domain.Money"
                },
                "end_date": {
                    "type": "string",
                    "example": "2026-11-16"
                },
                "interests": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/domain.Interest"
                    }
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Walk around Moscow"
                },
                "planning_area": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Moscow"
                },
                "start_date": {
                    "type": "string",
                    "example": "2026-11-14"
                },
                "start_location": {
                    "$ref": "#/definitions/domain.Location"
                },
                "time_zone": {
                    "type": "string",
                    "example": "Europe/Moscow"
                }
            }
        },
        "trips_transport_http.PatchTripRequest": {
            "type": "object",
            "properties": {
                "budget": {
                    "$ref": "#/definitions/domain.Money"
                },
                "end_date": {
                    "type": "string",
                    "example": "2026-11-16"
                },
                "interests": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Interest"
                    }
                },
                "name": {
                    "type": "string",
                    "example": "Walk around NYC"
                },
                "planning_area": {
                    "type": "string",
                    "example": "NYC"
                },
                "start_date": {
                    "type": "string",
                    "example": "2026-11-14"
                },
                "start_location": {
                    "$ref": "#/definitions/domain.Location"
                },
                "time_zone": {
                    "type": "string",
                    "example": "Europe/Moscow"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 5
                }
            }
        },
        "trips_transport_http.TripResponse": {
            "type": "object",
            "properties": {
                "budget": {
                    "$ref": "#/definitions/domain.Money"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-10-28T12:00:00Z"
                },
                "deleted_at": {
                    "type": "string",
                    "example": ""
                },
                "end_date": {
                    "type": "string",
                    "example": "2026-11-16T00:00:00Z"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "interests": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.Interest"
                    }
                },
                "name": {
                    "type": "string",
                    "example": "Walk around Moscow"
                },
                "owner_id": {
                    "type": "integer",
                    "example": 1
                },
                "planning_area": {
                    "type": "string",
                    "example": "Moscow"
                },
                "start_date": {
                    "type": "string",
                    "example": "2026-11-14T00:00:00Z"
                },
                "start_location": {
                    "$ref": "#/definitions/domain.Location"
                },
                "time_zone": {
                    "type": "string",
                    "example": "Europe/Moscow"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-10-28T12:00:00Z"
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "users_transport_http.CreateUserRequest": {
            "type": "object",
            "required": [
                "birth_date",
                "email",
                "name",
                "password",
                "phone_number",
                "surname",
                "username"
            ],
            "properties": {
                "birth_date": {
                    "type": "string",
                    "example": "2006-01-02"
                },
                "description": {
                    "type": "string",
                    "maxLength": 1000,
                    "example": "Some kind of description"
                },
                "email": {
                    "type": "string",
                    "example": "checkemail@gmail.com"
                },
                "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Name"
                },
                "password": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 8,
                    "example": "some-random-ROBUST-password-1234!!!"
                },
                "phone_number": {
                    "type": "string",
                    "example": "+79990746978"
                },
                "surname": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 1,
                    "example": "Surname"
                },
                "username": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1,
                    "example": "Username"
                }
            }
        },
        "users_transport_http.PatchUserRequest": {
            "type": "object",
            "properties": {
                "birth_date": {
                    "type": "string",
                    "example": "2006-01-02"
                },
                "description": {
                    "type": "string",
                    "example": "Some kind of description"
                },
                "email": {
                    "type": "string",
                    "example": "checkemail@gmail.com"
                },
                "name": {
                    "type": "string",
                    "example": "Name"
                },
                "phone_number": {
                    "type": "string",
                    "example": "+79990746978"
                },
                "surname": {
                    "type": "string",
                    "example": "Surname"
                },
                "username": {
                    "type": "string",
                    "example": "Username"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                }
            }
        },
        "users_transport_http.UserResponse": {
            "type": "object",
            "properties": {
                "birth_date": {
                    "type": "string",
                    "example": "2006-01-02"
                },
                "created_at": {
                    "type": "string",
                    "example": "2006-01-02T15:06:07.292454Z"
                },
                "deleted_at": {
                    "type": "string",
                    "example": "2006-01-02T15:06:07.292454Z"
                },
                "description": {
                    "type": "string",
                    "example": "Some kind of description"
                },
                "email": {
                    "type": "string",
                    "example": "checkemail@gmail.com"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Name"
                },
                "phone_number": {
                    "type": "string",
                    "example": "+79990746978"
                },
                "surname": {
                    "type": "string",
                    "example": "Surname"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2006-01-02T15:06:07.292454Z"
                },
                "username": {
                    "type": "string",
                    "example": "Username"
                },
                "version": {
                    "type": "integer",
                    "example": 5
                }
            }
        }
    }
